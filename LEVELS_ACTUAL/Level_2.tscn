[sub_resource type="GDScript" id="GDScript_jopgt"]
script/source = "extends TextureRect

@export var tex_100: Texture2D
@export var tex_75: Texture2D
@export var tex_50: Texture2D
@export var tex_25: Texture2D
@export var tex_0: Texture2D

var _last_hp := 0
var _base_pos := Vector2.ZERO
var _base_scale := Vector2.ONE
var _base_rot := 0.0
var _base_mod := Color.WHITE
var _tween: Tween
var _flash := 0.0
var _dying := false

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	_base_pos = position
	_base_scale = scale
	_base_rot = rotation
	_base_mod = modulate
	pivot_offset = size * 0.5
	PlayerData.shield_hp = 0
	_last_hp = 0
	_dying = false
	visible = false
	modulate = _base_mod
	position = _base_pos
	scale = _base_scale
	rotation = _base_rot

func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_5:
			PlayerData.spawn_shield()

func _process(delta: float) -> void:
	var hp := PlayerData.shield_hp
	if hp != _last_hp:
		if hp > 0 and _last_hp <= 0:
			_on_spawn()
		elif hp > 0 and hp < _last_hp:
			_on_hit()
		elif hp <= 0 and _last_hp > 0:
			_on_break()
		_last_hp = hp
	if _flash > 0.0:
		_flash -= delta
		if _flash <= 0.0 and not _dying:
			modulate = _base_mod

func _refresh_tex() -> void:
	var hp := PlayerData.shield_hp
	match hp:
		5:
			texture = tex_100
		4:
			texture = tex_75
		3:
			texture = tex_50
		2:
			texture = tex_25
		1:
			texture = tex_0
		_:
			pass

func _kill_tween() -> void:
	if _tween:
		_tween.kill()

func _on_spawn() -> void:
	_dying = false
	_refresh_tex()
	visible = true
	modulate = _base_mod
	position = _base_pos + Vector2(0, -80)
	scale = _base_scale * Vector2(0.7, 1.25)
	rotation = _base_rot
	_kill_tween()
	_tween = create_tween()
	_tween.tween_property(self, \"position\", _base_pos, 0.28)\\
		.set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
	_tween.parallel().tween_property(self, \"scale\", _base_scale, 0.28)\\
		.set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)

func _on_hit() -> void:
	_refresh_tex()
	_flash = 0.1
	modulate = Color(6, 6, 6)
	_kill_tween()
	position = _base_pos
	rotation = _base_rot
	_tween = create_tween()
	_tween.tween_property(self, \"position:x\", _base_pos.x - 12.0, 0.04)
	_tween.tween_property(self, \"position:x\", _base_pos.x + 12.0, 0.04)
	_tween.tween_property(self, \"position:x\", _base_pos.x, 0.04)

func _on_break() -> void:
	_dying = true
	texture = tex_0
	visible = true
	_kill_tween()
	_tween = create_tween()
	_tween.set_parallel(true)
	_tween.tween_property(self, \"scale\", _base_scale * Vector2(1.35, 0.15), 0.28)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	_tween.tween_property(self, \"position:y\", _base_pos.y + 20.0, 0.28)
	_tween.tween_property(self, \"modulate:a\", 0.0, 0.35)
	_tween.chain().tween_callback(func() -> void:
		visible = false
		scale = _base_scale
		position = _base_pos
		rotation = _base_rot
		modulate = _base_mod
		_dying = false
	)
"

